#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "mjbots_quad"
    doc = """Generated from Composed Stage of root layer /tmp/tmp16t6of9s/mjbots_quad.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_quadruped_isaac_9mid60zb/usdex_quadruped_isaac/mjbots_quad.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_quadruped_isaac_9mid60zb/temp_quadruped_isaac/quadruped_isaac.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mjbots_quad" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </mjbots_quad/Physics/root_joint>,
        </mjbots_quad/Physics/bl_shoulder_joint>,
        </mjbots_quad/Physics/br_shoulder_joint>,
        </mjbots_quad/Physics/tl_shoulder_joint>,
        </mjbots_quad/Physics/tr_shoulder_joint>,
        </mjbots_quad/Physics/bl_thigh_joint>,
        </mjbots_quad/Physics/bl_leg_joint>,
        </mjbots_quad/Physics/br_thigh_joint>,
        </mjbots_quad/Physics/br_leg_joint>,
        </mjbots_quad/Physics/tl_thigh_joint>,
        </mjbots_quad/Physics/tl_leg_joint>,
        </mjbots_quad/Physics/tr_thigh_joint>,
        </mjbots_quad/Physics/tr_leg_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </mjbots_quad/Geometry/base_link>,
        </mjbots_quad/Geometry/base_link/bl_shoulder_link>,
        </mjbots_quad/Geometry/base_link/bl_shoulder_link/bl_thigh_link>,
        </mjbots_quad/Geometry/base_link/bl_shoulder_link/bl_thigh_link/bl_leg_link>,
        </mjbots_quad/Geometry/base_link/br_shoulder_link>,
        </mjbots_quad/Geometry/base_link/br_shoulder_link/br_thigh_link>,
        </mjbots_quad/Geometry/base_link/br_shoulder_link/br_thigh_link/br_leg_link>,
        </mjbots_quad/Geometry/base_link/tl_shoulder_link>,
        </mjbots_quad/Geometry/base_link/tl_shoulder_link/tl_thigh_link>,
        </mjbots_quad/Geometry/base_link/tl_shoulder_link/tl_thigh_link/tl_leg_link>,
        </mjbots_quad/Geometry/base_link/tr_shoulder_link>,
        </mjbots_quad/Geometry/base_link/tr_shoulder_link/tr_thigh_link>,
        </mjbots_quad/Geometry/base_link/tr_shoulder_link/tr_thigh_link/tr_leg_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "bl_shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "bl_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "bl_leg_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "bl_tip_link" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "br_shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "br_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "br_leg_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "br_tip_link" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "tl_shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "tl_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "tl_leg_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "tl_tip_link" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "tr_shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "tr_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "tr_leg_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "tr_tip_link" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bl_shoulder_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bl_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bl_leg_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "br_shoulder_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "br_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "br_leg_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tl_shoulder_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tl_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tl_leg_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tr_shoulder_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tr_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tr_leg_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

