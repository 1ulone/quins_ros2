<?xml version="1.0"?>
<robot name="mjbots_quad" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controller_config" default=""/>

  <link name="dummy"/>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://quins/meshes/QUAD_BODY.stl" scale="0.1 0.1 0.1"/> 
      </geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://quins/meshes/QUAD_BODY_C.stl" scale="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="1.920" ixy="0" ixz="0" iyy="3.204" iyz="0" izz="3.921"/>
    </inertial>
  </link>

  <!-- ==================== BACK LEFT LEG ==================== -->

  <joint name="bl_shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="bl_shoulder_link"/>
    <origin xyz="-0.66731 -1.2 -0.03" rpy="0 0 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10"/>
    <dynamics damping="10.0" friction="1.0"/>
  </joint>

  <link name="bl_shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
