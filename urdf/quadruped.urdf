<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:ns0="http://www.ros.org/wiki/xacro" name="quins">

  <ns0:arg name="controller_config" default="" />

  <material name="gray"><color rgba="0.5 0.5 0.5 1" /></material>
  <material name="dark_gray"><color rgba="0.2 0.2 0.2 1" /></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_BODY.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_BODY.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" /><mass value="3.0" />
      <inertia ixx="0.008125" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.028125" />
    </inertial>
  </link>

  <!-- ===================== LF ===================== -->
  <joint name="LF_HAA" type="revolute">
    <parent link="base_link" /><child link="LF_HIP" />
    <origin xyz="-0.157 0.060 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="LF_HIP">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_LF_HIP.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="-0.0265 0.015 0" rpy="0 0 0" /><mass value="0.7" />
      <inertia ixx="0.000793" ixy="0" ixz="0" iyy="0.001289" iyz="0" izz="0.000916" />
    </inertial>
  </link>

  <joint name="LF_HFE" type="revolute">
    <parent link="LF_HIP" /><child link="LF_THIGH" />
    <origin xyz="-0.053 0.030 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="LF_THIGH">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_LF_THIGH.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="gray" />
    </visual>
    <inertial>
      <origin xyz="0 0.086 -0.0899" rpy="0 0 0" /><mass value="0.8" />
      <inertia ixx="0.004087" ixy="0" ixz="0" iyy="0.002327" iyz="0" izz="0.002093" />
    </inertial>
  </link>

  <joint name="LF_KFE" type="revolute">
    <parent link="LF_THIGH" /><child link="LF_SHANK" />
    <origin xyz="0 0.172 -0.17985" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="LF_SHANK">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_LF_SHANK.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="0.020 0.01225 -0.11508" rpy="0 0 0" /><mass value="0.3" />
      <inertia ixx="0.001345" ixy="0" ixz="0" iyy="0.001345" iyz="0" izz="0.000045" />
    </inertial>
  </link>

  <joint name="LF_SHANK_TO_FOOT" type="fixed">
    <parent link="LF_SHANK" /><child link="LF_FOOT" />
    <origin xyz="0.040 0.0245 -0.23015" rpy="0 0 0" />
  </joint>
  <link name="LF_FOOT">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.014" /></geometry>
    </collision>
  </link>

  <!-- ===================== RF ===================== -->
  <joint name="RF_HAA" type="revolute">
    <parent link="base_link" /><child link="RF_HIP" />
    <origin xyz="-0.157 -0.060 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
