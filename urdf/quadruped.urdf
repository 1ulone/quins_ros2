        <mesh filename="package://quins/meshes/QUAD_BL_SHOULDER_C.stl" scale="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.182" ixy="0" ixz="0" iyy="0.187" iyz="0" izz="0.248"/>
    </inertial>
  </link>

  <joint name="bl_thigh_joint" type="revolute">
    <parent link="bl_shoulder_link"/>
    <child link="bl_thigh_link"/>
