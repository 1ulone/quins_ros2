      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="-0.0265 -0.015 0" rpy="0 0 0" /><mass value="0.7" />
      <inertia ixx="0.000793" ixy="0" ixz="0" iyy="0.001289" iyz="0" izz="0.000916" />
    </inertial>
  </link>

  <joint name="RF_HFE" type="revolute">
    <parent link="RF_HIP" /><child link="RF_THIGH" />
    <origin xyz="-0.053 -0.030 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="RF_THIGH">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_RF_THIGH.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="gray" />
    </visual>
    <inertial>
      <origin xyz="0 -0.086 -0.0899" rpy="0 0 0" /><mass value="0.8" />
      <inertia ixx="0.004087" ixy="0" ixz="0" iyy="0.002327" iyz="0" izz="0.002093" />
    </inertial>
  </link>

  <joint name="RF_KFE" type="revolute">
    <parent link="RF_THIGH" /><child link="RF_SHANK" />
    <origin xyz="0 -0.172 -0.17985" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="RF_SHANK">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_RF_SHANK.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="0.020 -0.01225 -0.11508" rpy="0 0 0" /><mass value="0.3" />
      <inertia ixx="0.001345" ixy="0" ixz="0" iyy="0.001345" iyz="0" izz="0.000045" />
    </inertial>
  </link>

  <joint name="RF_SHANK_TO_FOOT" type="fixed">
    <parent link="RF_SHANK" /><child link="RF_FOOT" />
    <origin xyz="0.040 -0.0245 -0.23015" rpy="0 0 0" />
  </joint>
  <link name="RF_FOOT">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.014" /></geometry>
    </collision>
  </link>

  <!-- ===================== LH ===================== -->
  <joint name="LH_HAA" type="revolute">
    <parent link="base_link" /><child link="LH_HIP" />
    <origin xyz="0.157 0.060 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="LH_HIP">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_LH_HIP.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="0.0265 0.015 0" rpy="0 0 0" /><mass value="0.7" />
      <inertia ixx="0.000793" ixy="0" ixz="0" iyy="0.001289" iyz="0" izz="0.000916" />
    </inertial>
  </link>

  <joint name="LH_HFE" type="revolute">
    <parent link="LH_HIP" /><child link="LH_THIGH" />
    <origin xyz="0.053 0.030 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="LH_THIGH">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_LH_THIGH.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="gray" />
    </visual>
    <inertial>
      <origin xyz="0 0.086 -0.0899" rpy="0 0 0" /><mass value="0.8" />
      <inertia ixx="0.004087" ixy="0" ixz="0" iyy="0.002327" iyz="0" izz="0.002093" />
    </inertial>
  </link>

  <joint name="LH_KFE" type="revolute">
    <parent link="LH_THIGH" /><child link="LH_SHANK" />
    <origin xyz="0 0.172 -0.17985" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="LH_SHANK">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_LH_SHANK.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="0.020 0.01225 -0.11508" rpy="0 0 0" /><mass value="0.3" />
      <inertia ixx="0.001345" ixy="0" ixz="0" iyy="0.001345" iyz="0" izz="0.000045" />
    </inertial>
  </link>

  <joint name="LH_SHANK_TO_FOOT" type="fixed">
    <parent link="LH_SHANK" /><child link="LH_FOOT" />
    <origin xyz="0.040 0.0245 -0.23015" rpy="0 0 0" />
  </joint>
  <link name="LH_FOOT">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.014" /></geometry>
    </collision>
  </link>

  <!-- ===================== RH ===================== -->
  <joint name="RH_HAA" type="revolute">
    <parent link="base_link" /><child link="RH_HIP" />
    <origin xyz="0.157 -0.060 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="RH_HIP">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_RH_HIP.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="0.0265 -0.015 0" rpy="0 0 0" /><mass value="0.7" />
      <inertia ixx="0.000793" ixy="0" ixz="0" iyy="0.001289" iyz="0" izz="0.000916" />
    </inertial>
  </link>

  <joint name="RH_HFE" type="revolute">
    <parent link="RH_HIP" /><child link="RH_THIGH" />
    <origin xyz="0.053 -0.030 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="RH_THIGH">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_RH_THIGH.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="gray" />
    </visual>
    <inertial>
      <origin xyz="0 -0.086 -0.0899" rpy="0 0 0" /><mass value="0.8" />
      <inertia ixx="0.004087" ixy="0" ixz="0" iyy="0.002327" iyz="0" izz="0.002093" />
    </inertial>
  </link>

  <joint name="RH_KFE" type="revolute">
    <parent link="RH_THIGH" /><child link="RH_SHANK" />
    <origin xyz="0 -0.172 -0.17985" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>
  <link name="RH_SHANK">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quins_ros2/meshes/QUINS_RH_SHANK.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="dark_gray" />
    </visual>
    <inertial>
      <origin xyz="0.020 -0.01225 -0.11508" rpy="0 0 0" /><mass value="0.3" />
      <inertia ixx="0.001345" ixy="0" ixz="0" iyy="0.001345" iyz="0" izz="0.000045" />
